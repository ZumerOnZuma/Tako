local function removeGachaReveal()
    local rs = game:GetService("ReplicatedStorage")
    local remotes = rs:FindFirstChild("Remotes")
    if not remotes then
        warn("Remotes не найден")
        return
    end
    -- оба варианта имени (опечатка GachaRevial / правильное GachaReveal)
    local gacha = remotes:FindFirstChild("GachaReveal")
        or remotes:FindFirstChild("GachaRevial")
    if gacha then
        local name = gacha.Name
        pcall(function()
            gacha:Destroy()
        end)
        print(name .. " удалён")
    else
        -- запасной поиск по части имени
        for _, child in ipairs(remotes:GetChildren()) do
            if string.find(string.lower(child.Name), "gacha", 1, true) then
                pcall(function() child:Destroy() end)
                print(child.Name .. " удалён (по поиску)")
                return
            end
        end
        warn("GachaReveal / GachaRevial не найден в Remotes")
    end
end

